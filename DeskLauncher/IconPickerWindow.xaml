<Window x:Class="DeskLauncher.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskLauncher"
        Title="Elegir icono" Width="560" Height="580" MinWidth="460" MinHeight="480"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBg}"
        FontFamily="{StaticResource UiFont}" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Image DockPanel.Dock="Right" Source="pack://application:,,,/Assets/logo.png" Width="128" Height="128"
                   VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel>
            <TextBlock Text="Biblioteca de iconos" FontFamily="{StaticResource UiDisplayFont}" FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Elige un icono o agrega uno nuevo." Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <local:IconLibraryView x:Name="Library"/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="Seleccionar" IsDefault="True"
                    MinWidth="96" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" MinWidth="96" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
