<Window x:Class="DeskLauncher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" ShowActivated="False"
        WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}">
    <Border Margin="24" Padding="48,36" CornerRadius="16" Background="#F01C1C1C"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="128" Height="128"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="DeskLauncher" Margin="0,18,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource UiDisplayFont}" FontSize="26" FontWeight="SemiBold"
                       Foreground="White"/>
            <ProgressBar IsIndeterminate="True" Height="3" Width="160" Margin="0,18,0,0"/>
        </StackPanel>
    </Border>
</Window>
