<Window x:Class="DeskLauncher.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False"
        Width="84" Height="100" AllowDrop="True" ShowActivated="False">
    <Border x:Name="Root" Background="#01000000" Cursor="Hand">
        <Border.ContextMenu>
            <ContextMenu Opened="DockMenu_Opened">
                <MenuItem Header="Abrir Manager" Click="OpenManager_Click"/>
                <MenuItem Header="Estilo de accesos">
                    <MenuItem x:Name="StyleArc" Header="Arco" Tag="Arc" IsCheckable="True" Click="Style_Click"/>
                    <MenuItem x:Name="StyleRing" Header="Anillo" Tag="Ring" IsCheckable="True" Click="Style_Click"/>
                    <MenuItem x:Name="StylePhone" Header="Phone App" Tag="Phone" IsCheckable="True" Click="Style_Click"/>
                </MenuItem>
                <MenuItem Header="Cambiar icono…" Click="ChangeIcon_Click"/>
                <MenuItem Header="Restablecer icono" Click="ResetIcon_Click"/>
                <MenuItem Header="Eliminar carpeta" Click="Delete_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="CustomGlyph" Width="58" Height="50" Stretch="Uniform" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.55"/>
                </Image.Effect>
            </Image>
            <Canvas x:Name="Glyph" Width="58" Height="50">
                <Canvas.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.55"/>
                </Canvas.Effect>
                <Path Fill="#2F7BD6" Data="M2,10 Q2,3 9,3 L22,3 L29,11 L49,11 Q56,11 56,17 L56,24 L2,24 Z"/>
                <Rectangle Canvas.Left="2" Canvas.Top="13" Width="54" Height="35" RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#63B6FF" Offset="0"/>
                            <GradientStop Color="#2468C8" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
            <TextBlock x:Name="NameText" Foreground="White" FontSize="12" Margin="0,6,0,0"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
