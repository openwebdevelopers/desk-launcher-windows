<Window x:Class="DeskLauncher.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskLauncher"
        Title="DeskLauncher Manager" Width="1020" Height="740" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <local:ShortcutIconConverter x:Key="ShortcutIcon"/>
        <local:FolderIconConverter x:Key="FolderIcon"/>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <!-- Toggled from code-behind: Collapsed makes every button icon-only (narrow window). -->
        <Visibility x:Key="LabelVis">Visible</Visibility>
        <!-- Collapsed when only one profile is left (cannot be deleted). -->
        <Visibility x:Key="DeleteProfileVis">Visible</Visibility>
        <Style x:Key="BtnLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="{DynamicResource LabelVis}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock Text="DeskLauncher" FontFamily="{StaticResource UiDisplayFont}"
                               FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{local:Tr Manager}" Style="{StaticResource Caption}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="ActiveProfileText" Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{local:Tr ActiveProfile}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="{local:Tr Navigation}" Style="{StaticResource Caption}" Margin="20,0,0,8"/>
                    <RadioButton x:Name="NavFolders" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="0,0,12,0"/>
                            <TextBlock Text="{local:Tr FoldersApps}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProfiles" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" Margin="0,0,12,0"/>
                            <TextBlock Text="{local:Tr Profiles}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,12,0"/>
                            <TextBlock Text="{local:Tr Settings}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="28,14,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- App logo, top-right on every Manager page -->
            <Image Grid.Row="0" Grid.RowSpan="2" Source="pack://application:,,,/Assets/logo.png" Width="128" Height="128" VerticalAlignment="Top" IsHitTestVisible="False"
                   HorizontalAlignment="Right" ToolTip="DeskLauncher"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Page: folders + apps -->
            <Grid x:Name="PageFolders" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,144,18" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="{local:Tr FoldersApps}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{local:Tr FoldersAppsDesc}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Folder list -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="9,6"
                                        Click="AddFolder_Click" ToolTip="{local:Tr NewFolder}">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13"/>
                                </Button>
                                <TextBlock Text="{local:Tr FoldersLabel}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Button x:Name="DeleteFolderBtn" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch" IsEnabled="False"
                                    Click="DeleteFolder_Click" ToolTip="{local:Tr DeleteFolderTip}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource DangerGlyph}" FontSize="13"/>
                                    <TextBlock Text="{local:Tr DeleteFolder}" Style="{StaticResource DangerText}"/>
                                </StackPanel>
                            </Button>
                            <ListBox x:Name="FolderList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource RowItem}" SelectionChanged="Folder_Changed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="36" Height="36" Margin="0,0,12,0">
                                                <Border Background="{DynamicResource TileBg}" CornerRadius="8"/>
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="18"
                                                           Foreground="{DynamicResource Accent}"/>
                                                <Image Margin="4" Source="{Binding Converter={StaticResource FolderIcon}}"/>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="{Binding Shortcuts.Count, Mode=OneWay}"/><Run Text="{local:Tr ShortcutsSuffix}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Folder detail -->
                    <Border x:Name="DetailCard" Grid.Column="2" Style="{StaticResource Card}" SizeChanged="DetailCard_SizeChanged">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="10" Background="{DynamicResource TileBg}" Margin="0,0,14,0">
                                    <Grid>
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="24"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <Image x:Name="FolderIconPreview" Margin="6"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{local:Tr FolderName}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NameBox" LostFocus="Name_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                    <Button Click="FolderIcon_Click" ToolTip="{local:Tr ChangeIcon}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}" FontSize="14"/>
                                            <TextBlock Text="{local:Tr ChangeIcon}" Style="{StaticResource BtnLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="8,0,0,0" Click="FolderIconReset_Click" ToolTip="{local:Tr ResetIcon}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" FontSize="14"/>
                                            <TextBlock Text="{local:Tr Reset}" Style="{StaticResource BtnLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid DockPanel.Dock="Top" Margin="4,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <TextBlock Text="{local:Tr LocationStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{local:Tr LocationStyleDesc}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <CheckBox x:Name="DesktopChk" Grid.Row="1" Content="{local:Tr Desktop}" VerticalAlignment="Center"
                                          Click="Location_Click"/>
                                <ComboBox x:Name="PanelStyleBox" Grid.Row="1" Grid.Column="1" Width="150" Margin="0,0,0,6"
                                          SelectionChanged="PanelStyle_Changed">
                                    <ComboBoxItem Tag="Arc" Content="{local:Tr StyleArc}"/>
                                    <ComboBoxItem Tag="Ring" Content="{local:Tr StyleRing}"/>
                                    <ComboBoxItem Tag="Phone" Content="{local:Tr StylePhone}"/>
                                </ComboBox>

                                <CheckBox x:Name="TaskbarChk" Grid.Row="2" Content="{local:Tr Taskbar}" VerticalAlignment="Center"
                                          Click="Location_Click"/>
                                <ComboBox x:Name="TaskbarStyleBox" Grid.Row="2" Grid.Column="1" Width="150"
                                          SelectionChanged="TaskbarStyle_Changed">
                                    <ComboBoxItem Tag="Box" Content="{local:Tr StyleBox}"/>
                                    <ComboBoxItem Tag="List" Content="{local:Tr StyleList}"/>
                                </ComboBox>
                            </Grid>

                            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                                <TextBlock Text="{local:Tr LinkedApps}" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Button Click="AddApp_Click" Margin="0,0,8,6" ToolTip="{local:Tr AddApp}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13"/>
                                        <TextBlock Text="{local:Tr AddApp}" Style="{StaticResource BtnLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AppIconBtn" Click="AppIcon_Click" Margin="0,0,8,6" IsEnabled="False"
                                        ToolTip="{local:Tr AppIconTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;" Style="{StaticResource ActionGlyph}" FontSize="14"/>
                                        <TextBlock Text="{local:Tr AppIcon}" Style="{StaticResource BtnLabel}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AppResetBtn" Click="AppIconReset_Click" Margin="0,0,8,6" IsEnabled="False"
                                        ToolTip="{local:Tr AppResetTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" Style="{StaticResource ActionGlyph}" FontSize="14"/>
                                        <TextBlock Text="{local:Tr Reset}" Style="{StaticResource BtnLabel}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource RowItem}" AllowDrop="True"
                                     SelectionChanged="AppList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="AppList_PreviewMouseDown"
                                     PreviewMouseMove="AppList_PreviewMouseMove"
                                     DragOver="AppList_DragOver" Drop="AppList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Tag="grip" Width="24" Margin="0,0,6,0" Background="Transparent"
                                                    Cursor="SizeAll" ToolTip="{local:Tr DragToReorder}">
                                                <TextBlock Text="&#xE76F;" Style="{StaticResource Glyph}"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource TileBg}" Margin="0,0,12,0">
                                                <Image Margin="6" Source="{Binding Converter={StaticResource ShortcutIcon}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TargetPath}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Margin="8,0,0,0" Padding="9,7" VerticalAlignment="Center"
                                                    ToolTip="{local:Tr RemoveFromFolder}" Click="DeleteApp_Click">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource RowDeleteGlyph}" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Page: profiles -->
            <Grid x:Name="PageProfiles" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,144,18" MinHeight="112">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" VerticalAlignment="Top"
                            Click="AddProfile_Click" ToolTip="{local:Tr NewProfile}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13"/>
                            <TextBlock Text="{local:Tr NewProfile}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{local:Tr Profiles}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{local:Tr ProfilesDesc}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" MinWidth="460" MaxWidth="560" HorizontalAlignment="Left">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{local:Tr AvailableProfiles}" Style="{StaticResource SectionLabel}" Margin="4,0,0,10"/>
                        <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource RowItem}" SelectionChanged="Profile_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource TileBg}" Margin="0,0,12,0">
                                            <!-- folder group: two stacked folders -->
                                            <Grid Width="22" Height="22">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="15"
                                                           Foreground="{DynamicResource TextSecondary}" Margin="-5,-5,0,0"/>
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="15"
                                                           Foreground="{DynamicResource Accent}" Margin="5,5,0,0"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Padding="9,7" Margin="8,0,0,0" ToolTip="{local:Tr RenameProfile}" Click="RenameProfile_Click">
                                            <TextBlock Text="&#xE70F;" Style="{StaticResource ActionGlyph}" FontSize="13"/>
                                        </Button>
                                        <Button Padding="9,7" Margin="6,0,0,0" ToolTip="{local:Tr DeleteProfile}" Click="DeleteProfile_Click"
                                                Visibility="{DynamicResource DeleteProfileVis}">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource RowDeleteGlyph}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                  </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Page: settings -->
            <Grid x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,144,18" MinHeight="112">
                    <TextBlock Text="{local:Tr Settings}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{local:Tr SettingsDesc}"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="150"
                                          SelectionChanged="Theme_Changed">
                                    <ComboBoxItem Tag="System" Content="{local:Tr System}"/>
                                    <ComboBoxItem Tag="Light" Content="{local:Tr Light}"/>
                                    <ComboBoxItem Tag="Dark" Content="{local:Tr Dark}"/>
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Tr Appearance}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{local:Tr AppearanceDesc}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ComboBox x:Name="LangBox" DockPanel.Dock="Right" Width="150"
                                          SelectionChanged="Lang_Changed">
                                    <ComboBoxItem Tag="System" Content="{local:Tr System}"/>
                                    <ComboBoxItem Tag="en" Content="English"/>
                                    <ComboBoxItem Tag="es" Content="Español"/>
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Tr Language}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{local:Tr LanguageDesc}"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <CheckBox x:Name="AutoStartBox" Content="{local:Tr AutoStart}" Click="AutoStart_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{local:Tr TaskbarPosition}" FontWeight="SemiBold"/>
                            <TextBlock Text="{local:Tr TaskbarPositionDesc}"
                                       Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="PosPanel"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Click="OpenLibrary_Click"
                                    ToolTip="{local:Tr OpenLibrary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}" FontSize="14"/>
                                    <TextBlock Text="{local:Tr OpenLibrary}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{local:Tr IconLibrary}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LibraryCountText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
